    {
      "name": "Payments (Pix simulado)",
      "item": [
        {
          "name": "Create Payment (clinic only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"Payment starts as pending with a pix_code\", function () {",
                  "    pm.expect(json.status).to.eql(\"pending\");",
                  "    pm.expect(json.pix_code).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"paymentId\", json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinic_id\": \"{{clinicId}}\",\n  \"amount_cents\": 15000\n}"
            },
            "url": "{{baseUrl}}/api/v1/payments"
          }
        },
        {
          "name": "Create Payment (with dentist)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"Payment is linked to the dentist\", function () {",
                  "    pm.expect(json.dentist_id).to.eql(pm.collectionVariables.get(\"dentistId\"));",
                  "});",
                  "pm.collectionVariables.set(\"paymentWithDentistId\", json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clinic_id\": \"{{clinicId}}\",\n  \"dentist_id\": \"{{dentistId}}\",\n  \"amount_cents\": 25000\n}"
            },
            "url": "{{baseUrl}}/api/v1/payments"
          }
        },
        {
          "name": "Get Payment by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Status is pending or approved\", function () {",
                  "    pm.expect([\"pending\", \"approved\"]).to.include(pm.response.json().status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}",
            "description": "O status começa como `pending`. O provedor Pix simulado aprova automaticamente após um delay aleatório de 2-5s em background — repita esta requisição (ex: usando o botão \"Send\" de novo) até ver `\"status\": \"approved\"`."
          }
        }
      ]
    },
